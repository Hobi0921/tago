<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Only used for the Have I Been Pwned range API, which never receives
         a full password hash. No other network calls are made. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets a login saved from an app be named after it ("Netflix", not
         "com.netflix.mediaclient"). Launcher apps only; no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PassVaultApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PassVault">

        <!-- Unlock screen is the launcher. Nothing else runs until the vault is open. -->
        <activity
            android:name=".ui.UnlockActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run welcome, shown once before setup. UnlockActivity routes here. Out of
             Recents like the rest of the task. -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Autofill service -->
        <service
            android:name=".autofill.PassVaultAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill.autofill_service"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Started by the autofill framework over another app: unlock to fill, and unlock
             to save. Transparent, out of Recents, and not recreated on rotation (a recreated
             instance would lose the biometric prompt and sit invisibly over the app). -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PassVault.Transparent" />

        <activity
            android:name=".autofill.SaveAuthActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PassVault.Transparent" />
    </application>
</manifest>
