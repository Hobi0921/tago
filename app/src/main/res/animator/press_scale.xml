<?xml version="1.0" encoding="utf-8"?>
<!-- Press feedback for big primary buttons: 0.97 on touch-down in 100ms, back in 160ms.
     Scale only (cheap), and the ripple still plays on top. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="100" android:interpolator="@interpolator/ease_out_strong"
                android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:duration="100" android:interpolator="@interpolator/ease_out_strong"
                android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="160" android:interpolator="@interpolator/ease_out_strong"
                android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:interpolator="@interpolator/ease_out_strong"
                android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
