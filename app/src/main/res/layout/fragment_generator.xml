<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Passphrase used to be a one-shot button that ignored the length slider
             and could not be tuned. It is a mode now, with its own controls. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/genMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedButton="@+id/genModeChars"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/genModeChars"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gen_mode_chars"
                android:textColor="@color/toggle_text" />

            <Button
                android:id="@+id/genModeWords"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gen_mode_words"
                android:textColor="@color/toggle_text" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- No hyphenation: an auto-inserted "-" at a line break would read as part
             of the password, and passphrases are exactly the dictionary words it targets. -->
        <TextView
            android:id="@+id/genOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:breakStrategy="simple"
            android:fontFamily="monospace"
            android:hyphenationFrequency="none"
            android:letterSpacing="0.06"
            android:lineSpacingExtra="6dp"
            android:padding="18dp"
            android:textColor="@color/accent"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <!-- The rating, led by a small grid that traces a fresh pattern whenever a password is
             deliberately generated (first show, Regenerate). Slider and option changes update
             the password without replaying it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.passvault.ui.TraceView
                android:id="@+id/genTrace"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/genRating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/genLengthLabel"
            style="@style/MutedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/genLength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="20"
            android:valueFrom="8"
            android:valueTo="64"
            app:thumbColor="@color/accent"
            app:trackColorActive="@color/accent"
            app:trackColorInactive="@color/input" />

        <!-- Character-password options -->
        <LinearLayout
            android:id="@+id/genCharOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/genLower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/gen_lower"
                android:textColor="@color/text_secondary" />

            <CheckBox
                android:id="@+id/genUpper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/gen_upper"
                android:textColor="@color/text_secondary" />

            <CheckBox
                android:id="@+id/genDigits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/gen_digits"
                android:textColor="@color/text_secondary" />

            <CheckBox
                android:id="@+id/genSymbols"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/gen_symbols"
                android:textColor="@color/text_secondary" />

            <CheckBox
                android:id="@+id/genAmbiguous"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/gen_ambiguous"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Passphrase options -->
        <LinearLayout
            android:id="@+id/genWordOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/genWordsNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/gen_words_number"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <Button
            android:id="@+id/genRegenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/accent"
            android:text="@string/gen_regenerate"
            android:textColor="@color/bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/genCopy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gen_copy"
                android:textColor="@color/accent" />

            <Button
                android:id="@+id/genSave"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gen_save"
                android:textColor="@color/accent" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
