<?xml version="1.0" encoding="utf-8"?>
<!-- Entry detail. Opens as a bottom sheet so looking something up stays a
     one-handed job: the copy buttons land where the thumb already is. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_sheet_handle" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Avatar: the site's real logo on a soft brand-tinted circle (Avatars + SiteIcons),
                 with the coloured initial underneath as the fallback. -->
            <FrameLayout
                android:id="@+id/detailAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_avatar"
                android:importantForAccessibility="no">

                <TextView
                    android:id="@+id/detailInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textSize="21dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/detailIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PassVault.SiteIcon" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detailSite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/detailFavorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/detail_favorite_add"
                android:padding="12dp"
                android:src="@drawable/ic_star_border" />
        </LinearLayout>

        <!-- Username -->
        <LinearLayout
            android:id="@+id/detailUsernameRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DetailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_username" />

                <TextView
                    android:id="@+id/detailUsername"
                    style="@style/DetailValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textIsSelectable="true" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/detailCopyUsername"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/detail_copy_username"
                android:padding="12dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_code"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DetailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_password" />

                <TextView
                    android:id="@+id/detailPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:breakStrategy="simple"
                    android:fontFamily="monospace"
                    android:hyphenationFrequency="none"
                    android:letterSpacing="0.04"
                    android:textColor="@color/accent"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/detailReveal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/detail_reveal"
                android:padding="12dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/detailCopyPassword"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/vault_copy"
                android:padding="12dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/accent" />
        </LinearLayout>

        <!-- 2FA -->
        <LinearLayout
            android:id="@+id/detailTotpRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_code"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DetailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_totp" />

                <TextView
                    android:id="@+id/detailTotp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Countdown ring with the seconds inside it. The seconds are sized in dp on
                 purpose: they live inside a fixed 34dp graphic, and at large font scales
                 sp text overflowed the ring. tnum stops the number wobbling each tick. -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/detailTotpRing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="30"
                    app:indicatorColor="@color/accent"
                    app:indicatorSize="34dp"
                    app:trackColor="@color/border"
                    app:trackThickness="3dp" />

                <TextView
                    android:id="@+id/detailTotpSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFeatureSettings="tnum"
                    android:importantForAccessibility="no"
                    android:textColor="@color/text_secondary"
                    android:textSize="11dp" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/detailCopyTotp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/detail_copy_totp"
                android:padding="12dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/accent" />
        </LinearLayout>

        <!-- Notes -->
        <LinearLayout
            android:id="@+id/detailNotesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                style="@style/DetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_notes" />

            <TextView
                android:id="@+id/detailNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:id="@+id/detailHistorySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_history"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/detailHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Actions: Edit is primary; Delete is small, red, and last. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/detailDelete"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_delete"
                android:textColor="@color/danger"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/danger" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/detailEdit"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/accent"
                android:paddingStart="24dp"
                android:paddingEnd="28dp"
                android:text="@string/detail_edit"
                android:textColor="@color/bg"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/bg" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
