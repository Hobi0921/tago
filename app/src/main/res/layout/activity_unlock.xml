<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable so that at large font and display sizes, with a long error message showing,
     Recover can't be pushed off-screen: for someone whose key is gone it's the only way back.
     fillViewport keeps everything centred when it does fit. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="40dp">

        <!-- Decorative: the app name is the very next line, so TalkBack shouldn't read it twice. -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="30sp"
            android:letterSpacing="0.02"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/unlock_tagline"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/unlockStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/unlock_hint"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/unlockButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/accent"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:text="@string/unlock_button"
            android:textColor="@color/bg"
            android:textStyle="bold" />

        <!-- Only shown once the key is known to be gone. Until then, offering to
             erase the vault next to "Try again" would be an invitation to disaster. -->
        <Button
            android:id="@+id/unlockRecover"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/unlock_recover"
            android:textColor="@color/text_muted"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
