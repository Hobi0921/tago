<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- A 3dp colour bar rather than an icon: severity is the only thing that
         varies between rows, so it is the only thing that should carry colour. -->
    <View
        android:id="@+id/findingSeverity"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="14dp"
        android:background="@color/danger"
        android:minHeight="44dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/findingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/findingDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Affected entries as chips rather than a text list: a count tells you a
             problem exists, a tappable name takes you to the thing you must fix. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/findingEntries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingVertical="2dp" />

        <TextView
            android:id="@+id/findingMore"
            style="@style/MutedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
