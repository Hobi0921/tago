<?xml version="1.0" encoding="utf-8"?>
<!-- Redesigned vault. Search first (it's what people come here to do), then the breach alert,
     then the backup reminder, then the list. Keeps every id from the previous version,
     including the no-results state and the scrollable empty state from the last fix. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            app:boxBackgroundColor="@color/input"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/accent"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="clear_text"
            app:endIconTint="@color/text_muted"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/text_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/vaultSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/vault_search"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Breach alert. Only shown when the last breach check found something; the whole
             card is the tap target (not just the small link), and it opens the Health tab. -->
        <LinearLayout
            android:id="@+id/vaultBreachBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_breach_banner"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="96dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/vaultBreachTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/banner_text"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:text="@string/vault_breach_details"
                android:textColor="@color/banner_link"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Turn on autofill. It's what makes Tago useful outside itself, and it lives in a
             system screen nobody visits unprompted. Shown until autofill is on or the card is
             dismissed (Settings keeps the option). One nudge at a time: while this shows, the
             backup reminder waits. -->
        <LinearLayout
            android:id="@+id/vaultAutofillCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/vault_autofill_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:text="@string/vault_autofill_body"
                android:textAppearance="@style/TextAppearance.PassVault.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/vaultAutofillOn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_autofill_action"
                    android:textColor="@color/accent" />

                <Button
                    android:id="@+id/vaultAutofillDismiss"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_autofill_dismiss"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- Only shown when there has never been an export and the vault has enough
             in it to be worth losing. Dismissible, and gone for good after a backup. -->
        <LinearLayout
            android:id="@+id/vaultBackupBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/vault_backup_reminder"
                android:textColor="@color/warning"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/vaultBackupAction"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_backup_action"
                    android:textColor="@color/accent" />

                <Button
                    android:id="@+id/vaultBackupDismiss"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_backup_dismiss"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vaultList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="88dp" />

            <!-- Empty vault: an invitation to act, with the restore path up front
                 for someone setting up a new phone. Scrollable so at large font sizes
                 (or with a banner showing) Restore can't fall off-screen. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/vaultEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="40dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="40dp"
                    android:paddingBottom="24dp">

                    <ImageView
                        android:id="@+id/vaultEmptyIcon"
                        android:layout_width="160dp"
                        android:layout_height="133dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ill_onboarding" />

                    <TextView
                        android:id="@+id/vaultEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/vault_empty"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/vaultEmptyDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/vault_empty_detail"
                        android:textAppearance="@style/TextAppearance.PassVault.Body" />

                    <Button
                        android:id="@+id/vaultEmptyAdd"
                        style="@style/Widget.PassVault.Button.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:text="@string/vault_empty_add" />

                    <Button
                        android:id="@+id/vaultEmptyRestore"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vault_empty_restore"
                        android:textColor="@color/accent" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Search with zero matches. Deliberately not the empty-vault view: that one
                 says the vault is empty and offers Add/Restore, which is false here. -->
            <LinearLayout
                android:id="@+id/vaultNoResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="48dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:visibility="gone">

                <!-- The nine-dot grid with nothing traced: no pattern matched. -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ill_grid_idle" />

                <TextView
                    android:id="@+id/vaultNoResultsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/vault_no_results_detail"
                    android:textAppearance="@style/TextAppearance.PassVault.Body" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/vaultAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/vault_add"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/action"
        app:elevation="2dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@color/on_action" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
