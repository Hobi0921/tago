<?xml version="1.0" encoding="utf-8"?>
<!-- First-run screen. Art on top, one inset card with the promise and a single primary
     action. Scrolls as a whole so at the largest font size Continue is never pushed off. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_peach"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/onboardingArt"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:minHeight="220dp"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="48dp"
            android:scaleType="fitCenter"
            android:src="@drawable/avd_onboarding" />

        <!-- Overlaps the art slightly so the two read as one composition. -->
        <LinearLayout
            android:id="@+id/onboardingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-32dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sheet_top"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/onboardingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/onboarding_title"
                android:textAppearance="@style/TextAppearance.PassVault.Hero" />

            <TextView
                android:id="@+id/onboardingBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/onboarding_body"
                android:textAppearance="@style/TextAppearance.PassVault.Body" />

            <Button
                android:id="@+id/onboardingContinue"
                style="@style/Widget.PassVault.Button.Pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/onboarding_continue" />

            <!-- Says what the button leads to, so the system biometric sheet that follows is
                 expected rather than a surprise. -->
            <TextView
                android:id="@+id/onboardingNext"
                style="@style/MutedLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/onboarding_next" />

            <!-- The restore path up front for someone setting up a new phone. -->
            <Button
                android:id="@+id/onboardingRestore"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_restore"
                android:textColor="@color/accent" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
