<?xml version="1.0" encoding="utf-8"?>
<!-- Rendered inside other apps via RemoteViews, so only basic views are allowed.
     Colours are explicit (with values-night overrides) because otherwise the host
     app's defaults apply, which can mean dark text on a dark autofill popup. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/autofillTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/autofill_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/autofillSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/autofill_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
