<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: flat toolbar on the page colour with a large per-screen title (set it from the
     nav listener), and the bottom nav as a floating pill. Same ids as before. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg"
        android:paddingStart="4dp"
        app:menu="@menu/main_toolbar"
        app:title="@string/title_vault"
        app:titleTextAppearance="@style/TextAppearance.PassVault.ScreenTitle"
        app:titleTextColor="@color/text_primary" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom nav rather than top tabs: pulling up a password is usually a
         one-handed job at a checkout, so the targets belong within thumb reach.
         Floating pill, but in the layout flow (not overlaid), so it can never cover
         the last list row. Labels kept: icon-only tabs fail "where am I?". -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.PassVault.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
