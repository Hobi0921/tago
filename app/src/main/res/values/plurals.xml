<?xml version="1.0" encoding="utf-8"?>
<!-- Fix #4: "1 entries" / "1 reused passwords". Use with
     getResources().getQuantityString(R.plurals.x, n, n). Rename or reword to match
     your existing strings; the point is one string per quantity, never "%d" + "s". -->
<resources>
    <plurals name="entry_count">
        <item quantity="one">%d entry in your vault</item>
        <item quantity="other">%d entries in your vault</item>
    </plurals>
    <plurals name="finding_reused">
        <item quantity="one">%d password is reused</item>
        <item quantity="other">%d passwords are reused</item>
    </plurals>
    <plurals name="finding_weak">
        <item quantity="one">%d weak password</item>
        <item quantity="other">%d weak passwords</item>
    </plurals>
    <plurals name="finding_breached">
        <item quantity="one">%d password found in a breach</item>
        <item quantity="other">%d passwords found in breaches</item>
    </plurals>
    <plurals name="finding_more">
        <item quantity="one">+%d more</item>
        <item quantity="other">+%d more</item>
    </plurals>
</resources>
